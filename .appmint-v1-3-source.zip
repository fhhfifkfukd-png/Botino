
name: Build AppMint APK v1.5.0

on:
  workflow_dispatch:
  push:
    paths:
      - 'appmint-v1-3-source.zip'
      - '.github/workflows/build-appmint-v1-3.yml'

permissions:
  contents: read

jobs:
  build:
    name: Build AppMint Android APK
    runs-on: ubuntu-latest
    timeout-minutes: 40

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Check project ZIP
        run: |
          test -f appmint-v1-3-source.zip
          unzip -t appmint-v1-3-source.zip

      - name: Extract project
        run: |
          mkdir -p build-source
          unzip -q appmint-v1-3-source.zip -d build-source

          find build-source -maxdepth 3 -type f | head -100

          test -f build-source/settings.gradle.kts
          test -f build-source/app/build.gradle.kts

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v4

      - name: Install Android SDK
        run: |
          sdkmanager --install \
            "platform-tools" \
            "platforms;android-35" \
            "build-tools;35.0.0"

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Build APK
        working-directory: build-source
        run: |
          gradle --no-daemon --stacktrace :app:assembleDebug

      - name: Verify APK
        run: |
          test -s build-source/app/build/outputs/apk/debug/app-debug.apk

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: AppMint-Android-APK
          path: build-source/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 30
